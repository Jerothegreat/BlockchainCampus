CHAIN_ID=97
CONTRACT=0x08494bba10FF9E6C6562D1F495ab9b1361D2522f
GAS_PRICE_GWEI=0.1
RELAYER_PRIVATE_KEY=0x...
# Optional: enables POST /topup (cashier top-up without MetaMask)
