# Security (default on). Set to "false" ONLY while the POS frontend can't sign yet:
# REQUIRE_RECEIPT_SIG=false   -> /settle accepts unsigned receipts (forgeable)
# REQUIRE_DEVICE_SYNC=false   -> /sync is public (leaks PIN verifiers)
